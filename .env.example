# Whapi.cloud
WHAPI_TOKEN=
WHAPI_BASE_URL=https://gate.whapi.cloud

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Approximate USD per million tokens -- update to match current Anthropic pricing.
ANTHROPIC_PRICE_INPUT_PER_MTOK=3.0
ANTHROPIC_PRICE_OUTPUT_PER_MTOK=15.0

# Database (sqlite for local dev, postgres for prod)
DATABASE_URL=sqlite:///./digest.db

# Self-chat: the linked WhatsApp number to send digests to and accept commands from.
# International format, no +, no spaces, e.g. 971501234567
SELF_NUMBER=

# How you're referred to in group chats, so the summarizer can flag mentions of you.
USER_DISPLAY_NAME=

# Members who only show up as a phone number appear as SMM1, SMM2, ... in digests.
# Change the prefix, or leave it empty to turn this off and show numbers as-is.
MEMBER_ALIAS_PREFIX=SMM

# Admin page (/admin): add groups and run backfills from a browser.
# Leave ADMIN_PASSWORD empty to disable the page entirely. Use a long random value.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Webhook
WEBHOOK_BASE_URL=

# Digest schedule
TIMEZONE=Asia/Dubai
DAILY_DIGEST_HOUR=8
ENABLE_SCHEDULER=true

# Retention
RETENTION_DAYS=30

# Watchlist file
GROUPS_CONFIG_PATH=groups.yaml
